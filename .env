# Committed demo defaults for the bulk wire reference implementation.
# DEMO-ONLY: every secret below is a throwaway value generated for this local demo and committed on
# purpose. A real deployment injects secrets from a secret manager and never commits them.

# ---- Compose ----
COMPOSE_PROJECT_NAME=bulkwire

# ---- Temporal ----
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=bulkwire
TEMPORAL_TASK_QUEUE=bulkwire
TEMPORAL_UI_URL=http://localhost:8233
WORKER_DEPLOYMENT_NAME=bulkwire
WORKER_BUILD_ID=v1
WORKER_VERSIONING_ENABLED=true

# ---- Encryption (DEMO keyring; production keys come from a KMS) ----
CODEC_KEYRING_PATH=/config/keyring.json
CODEC_CORS_ORIGINS=http://localhost:8233

# ---- Auth (DEMO) ----
AUTH_SIGNING_KEY=DPCZBA9LDkjsR9vqNbaoBIVWHuWvyWV9dqNI87zX9JdWBFYl
DEMO_PASSWORD=demo

# ---- Claim check ----
CLAIMCHECK_BACKEND=redis
COMPOSE_PROFILES=local-temporal,claimcheck-redis
CLAIMCHECK_TTL=168h
CLAIMCHECK_PAGE_SIZE=500
REDIS_ADDR=redis:6379
# S3 backend: RustFS stands in for MinIO (MinIO no longer publishes images).
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=bulkwire-claimcheck
S3_ACCESS_KEY=bulkwire
S3_SECRET_KEY=bulkwire-secret
GCS_ENDPOINT=http://fake-gcs:4443/storage/v1/
GCS_BUCKET=bulkwire-claimcheck

# ---- Batch defaults (control-service can override per FI at runtime) ----
# Chunk size: any value from 1 to MAX_ROWS. Concurrency: per FI in config/routing.yaml (fiDefaults); this is the
# fallback for an FI without one.
DEFAULT_CHUNK_SIZE=250
DEFAULT_CONCURRENCY=4
MAX_ROWS=10000
# History guard: a batch needing more chunks than this is rejected at staging (and, as a backstop, at Draft).
# 1,300 keeps one batch's history under 25,000 events; see MaxChunksPerBatchDefault in go/internal/config.
MAX_CHUNKS_PER_BATCH=1300
APPROVAL_WINDOW=24h
CORE_RETRY_BUDGET=30m
# Production guidance is 1–2 min. Shortened so outage demos recover within seconds.
CORE_RETRY_MAX_INTERVAL=20s
CORE_RETRY_ALERT_THRESHOLD=5

# ---- Core (one per FI) ----
CORE_ENDPOINTS=lakeshore=http://core-lakeshore:8080,prairie=http://core-prairie:8080
MSSQL_SA_PASSWORD=Bwd94294e2d73ef9a4d3aa!Demo9
CORE_SQL_COMMAND_TIMEOUT_SECONDS=30
CORE_DUAL_CONTROL_THRESHOLD_CENTS=100000000
CORE_DEMO_TAC=246810
CORE_SIMULATED_LATENCY_MS=600
# Service-to-service tokens, one per FI. Each Core gets only its own; Go services get both (INTERNAL_TOKENS).
# PRODUCTION NOTE: mTLS or workload identity, and secrets from a secret store, never a committed file.
INTERNAL_TOKEN_LAKESHORE=748487dd10bdc62e512b4ef32a0dbb624de9918a94ea9008
INTERNAL_TOKEN_PRAIRIE=2058043121896a4a97cc527104211988a5477c1c61268514
BULKWIRE_INTERNAL_URL=http://bulkwire-service:8090

# ---- Control service (DEMO-ONLY) ----
CHAOS_ALLOWLIST=worker-a,worker-b,worker-v2,worker-v3,core-lakeshore,core-prairie,sql-lakeshore,sql-prairie,temporal,bulkwire-service,redis,rustfs,fake-gcs,codec-server
