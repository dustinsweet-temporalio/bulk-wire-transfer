# Temporal Cloud variant (documented, not the default). Copy the values below over the matching keys in
# .env, then follow "Temporal Cloud mode" in README.md.
#
# All Go binaries load their client options with go.temporal.io/sdk/contrib/envconfig, so the local dev
# server and Temporal Cloud differ only in these variables. Supplying an API key turns TLS on automatically.
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=<api key>

# Drop the local-temporal profile so the dev server, temporal-init, and worker-activate do not start.
COMPOSE_PROFILES=claimcheck-redis

# Codec Server URL to enter in the Temporal Cloud Web UI (Namespace settings → Codec Server).
# It must be reachable from the presenter's browser; the Temporal Service never sees the keys.
TEMPORAL_UI_URL=https://cloud.temporal.io/namespaces/<namespace>.<account>
